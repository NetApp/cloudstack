ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ARG NODE_VERSION=16.20.2

ENV DEBIAN_FRONTEND=noninteractive
ENV JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
# npm is a script with shebang `#!/usr/bin/env node`, so /opt/node/bin must be
# on PATH while the build verifies npm, not only in the finished image.
ENV PATH="/opt/cloudstack-driver/bin:/opt/node/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository -y universe \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        bzip2 \
        build-essential \
        ca-certificates \
        coreutils \
        curl \
        debhelper \
        default-mysql-client \
        devscripts \
        dpkg-dev \
        fakeroot \
        file \
        findutils \
        gawk \
        genisoimage \
        git \
        gzip \
        iproute2 \
        iptables \
        libffi-dev \
        libvirt-clients \
        lsb-release \
        maven \
        nfs-common \
        openjdk-17-jdk \
        openssh-client \
        procps \
        python3 \
        python3-dev \
        python3-distutils \
        python3-mysql.connector \
        python3-netaddr \
        python3-pip \
        python3-setuptools \
        python3-venv \
        rsync \
        sshpass \
        tar \
        uuid-runtime \
        wget \
        xz-utils \
    && update-alternatives --set java /usr/lib/jvm/java-17-openjdk-amd64/bin/java \
    && update-alternatives --set javac /usr/lib/jvm/java-17-openjdk-amd64/bin/javac \
    && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && mkdir -p /opt/node \
    && tar -xJf "node-v${NODE_VERSION}-linux-x64.tar.xz" -C /opt/node --strip-components=1 \
    && rm "node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && python3 -m venv /opt/cloudstack-driver \
    && /opt/cloudstack-driver/bin/pip install --no-cache-dir --upgrade pip pyvmomi pyyaml \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && bash --version >/dev/null \
    && dpkg-buildpackage --version >/dev/null \
    && git --version >/dev/null \
    && java -version >/dev/null \
    && mvn --version >/dev/null \
    && /opt/node/bin/node --version | grep -q "^v${NODE_VERSION}$" \
    && /opt/node/bin/npm --version | grep -q '^8\.' \
    && tar --version >/dev/null \
    && command -v ssh >/dev/null \
    && command -v sshpass >/dev/null \
    && command -v ssh-keygen >/dev/null \
    && command -v scp >/dev/null \
    && command -v ssh-keyscan >/dev/null \
    && command -v gzip >/dev/null \
    && command -v gawk >/dev/null \
    && command -v mysql >/dev/null \
    && command -v virsh >/dev/null \
    && command -v dpkg-scanpackages >/dev/null \
    && /opt/cloudstack-driver/bin/python -c 'import pyVim, pyVmomi, yaml' \
    && command -v node >/dev/null \
    && command -v npm >/dev/null
